# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Password
# Change this to a secure password of your choice
VITE_ADMIN_PASSWORD=basketball2025

# Local development only (ignored in production builds).
# Put these in .env.local, which git ignores.
# Skip the "pick the best player" gate while developing:
# VITE_DEV_SKIP_GATE=true
# Load src/data/sample-sessions.json when Supabase is not configured:
# VITE_DEV_SAMPLE_DATA=true
